# ============================================
# NETRA-AI Worker — Environment Configuration
# ============================================
# Copy this file to .env and adjust values.

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Model paths (relative to ai_worker root)
CLASSIFIER_WEIGHTS_PATH=model/weights/classifier.pt
DETECTOR_WEIGHTS_PATH=model/weights/detector.pt

# IQA Thresholds
BLUR_THRESHOLD=100.0
EXPOSURE_LOW=60
EXPOSURE_HIGH=220

# Clinical Decision Threshold
# Sensitivity-biased: 0.40 deliberately over-refers at the margin
REFERRAL_THRESHOLD=0.40

# CORS — Spring Boot origin
ALLOWED_ORIGINS=http://localhost:8080
